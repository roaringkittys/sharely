{
  "manifest_version": 3,
  "name": "Sharely Account Manager",
  "version": "1.1",
  "description": "Stealth admin tool for syncing session cookies to Sharely.",
  "action": {
    "default_popup": "./popup.html",
    "default_icon": {
      "16": "./icons/icon-16.png",
      "128": "./icons/icon-128.png"
    }
  },
  "host_permissions": [
    "*://*/*"
  ],
  "permissions": [
    "scripting",
    "storage",
    "activeTab",
    "tabs"
  ],
  "icons": {
    "16": "./icons/icon-16.png",
    "128": "./icons/icon-128.png"
  }
}
