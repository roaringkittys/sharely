{
  "manifest_version": 3,
  "name": "Sharely Account Manager",
  "version": "1.0",
  "description": "Sync session cookies from supported websites directly into Sharely as named accounts.",
  "action": {
    "default_popup": "./popup.html",
    "default_icon": {
      "16": "./icons/icon-16.png",
      "128": "./icons/icon-128.png"
    }
  },
  "host_permissions": [
    "*://*/*"
  ],
  "permissions": [
    "cookies",
    "storage",
    "activeTab",
    "tabs"
  ],
  "icons": {
    "16": "./icons/icon-16.png",
    "128": "./icons/icon-128.png"
  }
}
